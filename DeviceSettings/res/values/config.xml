<resources>

    <!-- Whether the panel is driven through a Pixelworks Iris5 chip that can do
         motion smoothing (MEMC). Shows the Display category and lets
         IrisMemcService run. -->
    <bool name="config_irisMemcSupported">false</bool>

    <!-- Video apps (package names) MEMC is requested for while one of their
         activities is on top. The chip starts MEMC itself once a video is
         playing. An item may also be package/class to match one activity. -->
    <string-array name="iris_memc_activities" translatable="false">
        <item>com.google.android.youtube</item>
        <item>com.netflix.mediaclient</item>
        <item>com.amazon.avod.thirdpartyclient</item>
        <item>in.startv.hotstar</item>
        <item>in.startv.hotstaronly</item>
        <item>org.videolan.vlc</item>
        <item>dev.anilbeesetti.nextplayer</item>
        <item>com.mxtech.videoplayer.ad</item>
        <item>com.mxtech.videoplayer.pro</item>
        <item>tv.danmaku.bili</item>
        <item>com.bilibili.app.in</item>
        <item>com.iqiyi.i18n</item>
        <item>com.disney.disneyplus</item>
        <item>com.wbd.stream</item>
        <item>tv.twitch.android.app</item>
        <item>com.stremio.one</item>
        <item>com.sonyliv</item>
        <item>com.graymatrix.did</item>
        <item>com.crunchyroll.crunchyroid</item>
        <item>com.plexapp.android</item>
